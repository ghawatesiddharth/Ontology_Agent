# =========================================================
# SUBJECTS
# =========================================================

:ArtificialIntelligence
    rdf:type :Subject ;
    :hasName "Artificial Intelligence" ;
    :hasCredits 4 ;
    :hasPrerequisite :DataStructures .


:MachineLearning
    rdf:type :Subject ;
    :hasName "Machine Learning" ;
    :hasCredits 4 ;
    :hasPrerequisite :ArtificialIntelligence .


:DatabaseManagementSystems
    rdf:type :Subject ;
    :hasName "Database Management Systems" ;
    :hasCredits 4 ;
    :hasPrerequisite :DataStructures .


:DataStructures
    rdf:type :Subject ;
    :hasName "Data Structures" ;
    :hasCredits 4 .


:ComputerNetworks
    rdf:type :Subject ;
    :hasName "Computer Networks" ;
    :hasCredits 4 ;
    :hasPrerequisite :DataStructures .


:OperatingSystems
    rdf:type :Subject ;
    :hasName "Operating Systems" ;
    :hasCredits 4 ;
    :hasPrerequisite :DataStructures .


:JavaProgramming
    rdf:type :Subject ;
    :hasName "Java Programming" ;
    :hasCredits 4 .


:WebTechnology
    rdf:type :Subject ;
    :hasName "Web Technology" ;
    :hasCredits 4 ;
    :hasPrerequisite :JavaProgramming .


