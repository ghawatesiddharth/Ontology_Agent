@prefix : <http://example.org/college#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# =========================================================
# COLLEGE
# =========================================================

:SanjivaniCollegeOfEngineering
    rdf:type :College ;
    :hasName "Sanjivani College of Engineering" ;
    :hasDepartment :InformationTechnology ;
    :hasDepartment :ComputerEngineering ;
    :hasDepartment :ArtificialIntelligenceDataScience ;
    :hasDepartment :MechanicalEngineering ;
    :hasDepartment :ElectronicsTelecommunication .


# =========================================================
# DEPARTMENTS
# =========================================================

:InformationTechnology
    rdf:type :Department ;
    :hasName "Information Technology" ;
    :hasFaculty :ProfRajendra ;
    :hasFaculty :ProfAnita ;
    :hasStudent :Student53 ;
    :hasStudent :Student54 ;
    :hasStudent :Student55 ;
    :hasStudent :Student56 ;
    :offersCourse :BTechInformationTechnology ;
    :offersSubject :ArtificialIntelligence ;
    :offersSubject :MachineLearning ;
    :offersSubject :DatabaseManagementSystems ;
    :offersSubject :DataStructures ;
    :offersSubject :ComputerNetworks ;
    :offersSubject :OperatingSystems ;
    :offersSubject :JavaProgramming ;
    :offersSubject :WebTechnology .


:ComputerEngineering
    rdf:type :Department ;
    :hasName "Computer Engineering" ;
    :hasFaculty :ProfAmit ;
    :offersSubject :DataStructures ;
    :offersSubject :DatabaseManagementSystems ;
    :offersSubject :OperatingSystems .


:ArtificialIntelligenceDataScience
    rdf:type :Department ;
    :hasName "Artificial Intelligence and Data Science" ;
    :hasFaculty :ProfNeha ;
    :offersSubject :MachineLearning ;
    :offersSubject :ArtificialIntelligence .


:MechanicalEngineering
    rdf:type :Department ;
    :hasName "Mechanical Engineering" .


:ElectronicsTelecommunication
    rdf:type :Department ;
    :hasName "Electronics and Telecommunication Engineering" .


# =========================================================
# COURSE
# =========================================================

:BTechInformationTechnology
    rdf:type :Course ;
    :hasName "B.Tech Information Technology" ;
    :containsSubject :DataStructures ;
    :containsSubject :DatabaseManagementSystems ;
    :containsSubject :ComputerNetworks ;
    :containsSubject :OperatingSystems ;
    :containsSubject :ArtificialIntelligence ;
    :containsSubject :MachineLearning ;
    :containsSubject :JavaProgramming ;
    :containsSubject :WebTechnology .


